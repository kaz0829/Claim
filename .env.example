# Private Solana mainnet RPC. Do not prefix any of these with VITE_.
RPC_URL=https://api.mainnet-beta.solana.com

# Dedicated distributor wallet. It sends STONK to claimers.
# Fund it with STONK plus a little SOL for fees. Never use your main wallet.
DISTRIBUTOR_PRIVATE_KEY=

# Locked to the verified STONK mint.
TOKEN_MINT=6GmAFSYs4gk3FDao5FzzySQpPZaWsa4rUJHacpMpUNgx

# Give every wallet this many whole tokens, or set ALLOCATIONS_JSON instead.
DEFAULT_ALLOCATION=

# Optional per-wallet list. Example: {"WalletAddress":"1000"}
ALLOCATIONS_JSON=

# Neon/Postgres connection string. Required on Vercel so claims are not paid twice.
DATABASE_URL=
