# Solana mainnet RPC. Use a dedicated provider in production.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58 secret key or JSON byte-array secret for the Solana DISTRIBUTOR.
# This wallet must hold STONK in its associated token account and enough SOL
# for fees/rent. Never use a treasury key with unrelated assets.
DISTRIBUTOR_PRIVATE_KEY=

# Locks the service to the verified STONK mint.
TOKEN_MINT=6GmAFSYs4gk3FDao5FzzySQpPZaWsa4rUJHacpMpUNgx

# Optional: flat amount (in whole tokens) every eligible address receives.
# For a per-address list, use server/allocations.json instead.
DEFAULT_ALLOCATION=

# Optional. Restrict which site may call this API. Use your deployed frontend
# origin in production, e.g. https://claim.yourtoken.xyz
CORS_ORIGIN=*

PORT=3000
