# RPC endpoint for the chain your token lives on.
RPC_URL=https://mainnet.base.org

# Private key of the DISTRIBUTOR wallet. This wallet HOLDS the airdrop tokens
# and sends them to claimers. It must be funded with the tokens and with gas.
# It is never a wallet that receives tokens from users.
DISTRIBUTOR_PRIVATE_KEY=

# Optional: flat amount (in whole tokens) every eligible address receives.
# For a per-address list, use server/allocations.json instead.
DEFAULT_ALLOCATION=

# Optional. Restrict which site may call this API. Use your deployed frontend
# origin in production, e.g. https://claim.yourtoken.xyz
CORS_ORIGIN=*

# Optional. Label shown in startup logs.
CHAIN_LABEL=Base

PORT=3000
